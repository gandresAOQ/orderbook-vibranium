# Binaries
#
# These patterns are anchored with a leading "/" on purpose: an unanchored
# `orderbook` / `loadtest` would match at ANY depth and silently exclude the
# source directories cmd/orderbook/ and scripts/loadtest/.
/bin/
/orderbook
/loadtest
*.exe

# Test / coverage
*.out
coverage.*

# Env & local
.env
.DS_Store

# Virtualenv used only to regenerate the architecture diagram (`make diagram`).
# The generated PNG IS committed; the toolchain to rebuild it is not.
.venv-diagrams/
__pycache__/
