# API
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Instrument (MVP: single asset)
SYMBOL=VIB

# Capacity of the in-process command/event channels (backpressure buffer).
ENGINE_BUFFER=65536

# --- Adapter selection -------------------------------------------------------
# "memory" runs everything in-process with zero infrastructure (make run).
# docker-compose.yml overrides these with the real infrastructure below.
#
#   EVENT_LOG_DRIVER      memory | kafka
#   WALLET_STORE_DRIVER   memory | postgres
#   TRADE_STORE_DRIVER    memory | postgres
#   ORDER_STORE_DRIVER    memory | postgres
#   CACHE_DRIVER          none   | redis
EVENT_LOG_DRIVER=memory
WALLET_STORE_DRIVER=memory
TRADE_STORE_DRIVER=memory
ORDER_STORE_DRIVER=memory
CACHE_DRIVER=none

# --- Real infra (used when the drivers above are not "memory") ---------------
# Kafka / Redpanda: one partition per symbol preserves per-book ordering.
KAFKA_BROKERS=localhost:19092
KAFKA_EVENTS_TOPIC=orderbook.events
KAFKA_CONSUMER_GROUP=settlement

# Postgres: wallets, trades, orders and the settlement idempotency journal.
DATABASE_URL=postgres://orderbook:orderbook@localhost:5432/orderbook?sslmode=disable
DB_MAX_CONNS=20
DB_CONNECT_TIMEOUT=5s

# Redis: read cache in front of wallet lookups (never authoritative).
REDIS_URL=redis://localhost:6379
REDIS_TTL=2s

# How long startup waits for dependencies before giving up.
INFRA_WAIT_TIMEOUT=60s
